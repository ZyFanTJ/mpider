---
import BaseLayout from '../layouts/BaseLayout.astro';
import { sitePath } from '../lib/site';
---
<BaseLayout title="页面不存在｜MPider" description="这个页面不存在或已移动。返回 MPider 首页，查看使用方法与风险说明。" noindex canonicalPath={sitePath('404.html')}>
  <main class="reading-page" id="main-content"><h1>404 · 页面未找到</h1><a class="back-link" href={sitePath()}>← 返回首页</a></main>
</BaseLayout>
